{
  "name": "fed-salao",
  "version": "2.1.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4209",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --runInBand --coverage",
    "dev": "npm start",
    "generate:pix": "node scripts/generate-pix.cjs",
    "build:pages": "ng build --configuration production --output-mode static --base-href /",
    "test:supabase": "node --test supabase/tests/*.test.cjs",
    "verify:supabase": "node scripts/verify-supabase.cjs",
    "test:email": "node --test supabase/functions/tests/*.test.mjs",
    "check:email": "npx --yes deno@2.9.6 check --config supabase/functions/send-email/deno.json supabase/functions/send-email/index.ts && npx --yes deno@2.9.6 check --config supabase/functions/send-email-worker/deno.json supabase/functions/send-email-worker/index.ts",
    "prepare:email": "node scripts/prepare-email.cjs",
    "verify:email": "node scripts/verify-email.cjs",
    "verify:gmail": "node scripts/verify-gmail.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-server": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@angular/ssr": "^20.3.40",
    "@fontsource/poppins": "^5.2.7",
    "bootstrap": "5.3",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@electric-sql/pglite": "^0.5.10",
    "@types/deno": "^2.7.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.2",
    "deno": "2.9.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "~5.9.2"
  }
}
